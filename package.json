{
  "name": "fermer",
  "version": "0.1.0",
  "description": "Git-native encrypted secrets manager. No server, no SaaS — secrets live in your repo, encrypted end-to-end.",
  "type": "module",
  "bin": {
    "fermer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "secrets",
    "env",
    "encryption",
    "dotenv",
    "security",
    "git"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0"
  }
}
